# glade, in Metaxu: the package manager's command line.
#
#     glade init [DIR] [--name NAME]       start a project (mx.toml, main.mx)
#     glade add NAME [REQ]                 add a registry dependency (REQ defaults to ^newest)
#     glade add NAME --git URL --rev REV   add a git dependency
#     glade add NAME --path DIR            add a path dependency
#     glade remove NAME
#     glade sync [--offline]               resolve, fetch, vendor, write mx.lock
#     glade update [NAME ...]              re-resolve, letting locked versions move
#     glade tree                           the dependency tree with versions
#     glade check                          verify mx_modules/ against mx.lock (CI)
#     glade search TEXT                    find packages in the registry
#     glade paths                          name -> root as JSON (what the compiler reads)
#
# Global options come first: --project DIR (default .), --registry X.
# A port of src/metaxu/glade/cli.py, which stays the reference: the
# parity test runs both over the same registry and compares lockfiles,
# output and error text. Every failure prints "glade: <why>" to stderr
# and exits 2; `check` exits 1 when the vendored trees drifted.

from std.env import args;
from std.io import eprintln;
from std.semver import version_to_string, compare_version;
from lock import read_lock, lock_find, lock_names;
from index import registry_refresh, registry_entry, registry_names;
from project import Project, project_open, project_sync, project_add, project_remove, project_tree,
    default_registry, check, paths_json, init, lower;

struct Options {
    project: string,
    registry: string,
    command: string,
    rest: Vec
}

fn parse_options(argv: Vec) -> Options {
    let @mut project = ".";
    let @mut registry = "";
    let @mut command = "";
    let @mut rest = Vec.new();
    let @mut i = 0;
    while i < len(argv) {
        let a = argv[i];
        if command == "" {
            if a == "--project" && i + 1 < len(argv) { project = argv[i + 1]; i = i + 1 } else {
            if a.find("--project=") == 0 { project = a[10:len(a)] } else {
            if a == "--registry" && i + 1 < len(argv) { registry = argv[i + 1]; i = i + 1 } else {
            if a.find("--registry=") == 0 { registry = a[11:len(a)] } else {
            if a.find("-") == 0 { raise("unrecognized option " + a) } else {
                command = a
            } } } } }
        } else {
            rest.push(a)
        };
        i = i + 1
    }
    if command == "" { raise("a command is required (init, add, remove, sync, update, tree, check, search, paths)") } else { () };
    Options { project: project, registry: registry, command: command, rest: rest }
}

# The value after `flag` in `rest`, or "".
fn flag_value(rest: Vec, flag: string) -> string {
    let @mut i = 0;
    let @mut value = "";
    while i < len(rest) {
        if rest[i] == flag && i + 1 < len(rest) { value = rest[i + 1]; i = i + 1 } else {
        if rest[i].find(flag + "=") == 0 { value = rest[i][len(flag) + 1:len(rest[i])] } else { () } };
        i = i + 1
    }
    value
}

fn has_flag(rest: Vec, flag: string) -> bool {
    let @mut i = 0;
    let @mut found = false;
    while i < len(rest) {
        if rest[i] == flag { found = true } else { () };
        i = i + 1
    }
    found
}

# The words in `rest` that are not options or option values.
fn positionals(rest: Vec, valued: Vec) -> Vec {
    let @mut out = Vec.new();
    let @mut i = 0;
    while i < len(rest) {
        let a = rest[i];
        if a.find("--") == 0 {
            let @mut takes_value = false;
            let @mut j = 0;
            while j < len(valued) {
                if a == valued[j] { takes_value = true } else { () };
                j = j + 1
            }
            if takes_value { i = i + 1 } else { () }
        } else {
            out.push(a)
        };
        i = i + 1
    }
    out
}

fn open(o: Options) -> Project {
    project_open(o.project, o.registry, true)
}

fn cmd_init(o: Options) -> int {
    let @mut valued = Vec.new();
    valued.push("--name");
    let pos = positionals(o.rest, valued);
    let dir = if len(pos) > 0 { pos[0] } else { "." };
    let path = init(dir, flag_value(o.rest, "--name"));
    print("wrote " + path);
    0
}

fn cmd_add(o: Options) -> int {
    let @mut valued = Vec.new();
    valued.push("--git"); valued.push("--rev"); valued.push("--path"); valued.push("--from");
    let pos = positionals(o.rest, valued);
    if len(pos) == 0 { raise("add needs a package name") } else { () };
    let name = pos[0];
    let requirement = if len(pos) > 1 { pos[1] } else { "" };
    let p = open(o);
    let spec = project_add(p, name, requirement, flag_value(o.rest, "--git"), flag_value(o.rest, "--rev"),
                           flag_value(o.rest, "--path"), flag_value(o.rest, "--from"));
    if spec.kind == "registry" {
        print("added " + spec.name + " = '" + spec.requirement_text + "'")
    } else {
        print("added " + spec.name + " (" + spec.kind + ")")
    };
    let synced = project_sync(open(o), Vec.new(), false, true);
    0
}

fn cmd_remove(o: Options) -> int {
    let pos = positionals(o.rest, Vec.new());
    if len(pos) == 0 { raise("remove needs a package name") } else { () };
    project_remove(open(o), pos[0]);
    print("removed " + pos[0]);
    let synced = project_sync(open(o), Vec.new(), false, true);
    0
}

fn cmd_sync(o: Options) -> int {
    let locked = project_sync(open(o), Vec.new(), false, has_flag(o.rest, "--offline") == false);
    print("locked " + len(locked).to_string() + " package(s)");
    0
}

fn cmd_update(o: Options) -> int {
    let p = open(o);
    let names = positionals(o.rest, Vec.new());
    let before = read_lock(p.root);
    let locked = project_sync(p, names, len(names) == 0, true);
    let @mut moved = Vec.new();
    let @mut i = 0;
    while i < len(locked) {
        let e = locked[i];
        let k = lock_find(before, e.name);
        let was = if k < 0 { "" } else { before[k].version };
        if e.version != "" && was != e.version {
            moved.push(e.name + " " + (if was == "" { "-" } else { was }) + " -> " + e.version)
        } else { () };
        i = i + 1
    }
    if len(moved) > 0 { print(moved.join("\n")) } else { print("nothing to update") };
    0
}

fn cmd_tree(o: Options) -> int {
    print(project_tree(open(o)));
    0
}

fn cmd_check(o: Options) -> int {
    let problems = check(o.project);
    let @mut i = 0;
    while i < len(problems) { print(problems[i]); i = i + 1 };
    if len(problems) > 0 { 1 } else { 0 }
}

fn cmd_search(o: Options) -> int {
    let pos = positionals(o.rest, Vec.new());
    if len(pos) == 0 { raise("search needs some text") } else { () };
    let text = lower(pos[0]);
    let p = open(o);
    let reg = default_registry(p);
    registry_refresh(reg, false);
    let names = registry_names(reg);
    let @mut hits = 0;
    let @mut i = 0;
    while i < len(names) {
        if lower(names[i]).find(text) >= 0 {
            hits = hits + 1;
            match registry_entry(reg, names[i]) {
                Some(e) => {
                    let @mut newest = "-";
                    let @mut best = None;
                    let @mut j = 0;
                    while j < len(e.versions) {
                        let ve = e.versions[j];
                        best = match best { None => Some(ve.version), Some(b) => if compare_version(ve.version, b) > 0 { Some(ve.version) } else { Some(b) } };
                        j = j + 1
                    }
                    match best { Some(b) => { newest = version_to_string(b) }, None => () };
                    print((names[i] + " " + newest + "  " + e.description).trim())
                },
                None => ()
            }
        } else { () };
        i = i + 1
    }
    if hits == 0 { print("no packages matching '" + pos[0] + "' in " + reg.source) } else { () };
    0
}

fn cmd_paths(o: Options) -> int {
    print(paths_json(o.project));
    0
}

fn dispatch(o: Options) -> int {
    if o.command == "init" { cmd_init(o) } else {
    if o.command == "add" { cmd_add(o) } else {
    if o.command == "remove" { cmd_remove(o) } else {
    if o.command == "sync" { cmd_sync(o) } else {
    if o.command == "update" { cmd_update(o) } else {
    if o.command == "tree" { cmd_tree(o) } else {
    if o.command == "check" { cmd_check(o) } else {
    if o.command == "search" { cmd_search(o) } else {
    if o.command == "paths" { cmd_paths(o) } else {
        raise("unknown command '" + o.command + "'")
    } } } } } } } } }
}

fn main() -> int {
    try {
        dispatch(parse_options(args()))
    } catch e {
        eprintln("glade: " + e);
        2
    }
}
