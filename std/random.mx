# std.random — randomness as an algebraic effect.
#
# `next()` is an effect operation, so the SOURCE of randomness is a
# handler choice rather than a global generator. That is the whole point:
#
#     with_seed(42, fn() -> simulation())        # reproducible
#     with_sequence(Vec of [3, 1, 4], fn() -> f) # scripted, for tests
#
# Ante has no Random module; this one is Metaxu's own.
#
# NO real-entropy default. The `with SYMBOL` runtime-mapping mechanism
# (examples/effect_mapping.mx) is the way a seed-from-the-OS default
# would be declared, but the interpreter's shim table currently offers
# only EFFECT_MUTEX_*/EFFECT_SPAWN/EFFECT_JOIN — there is no entropy
# shim, and a mapped symbol with no shim fails loudly. So `Random.next`
# is declared WITHOUT a default: performing it outside a handler is a
# loud unhandled-effect error, never a silently constant "random" number.
# Adding an EFFECT_RANDOM_SEED shim later is a one-line change here.
#
# The generator is Marsaglia's XORSHIFT64, written in Metaxu now that the
# language has bitwise operators (it was an ANSI-C LCG while it did not):
#
#     x ^= x << 13;  x ^= x >>> 7;  x ^= x << 17
#
# with one adjustment. Metaxu's `>>` is ARITHMETIC (it sign-extends, like
# LLVM's ashr and Python's `>>`), while xorshift's period argument needs
# the LOGICAL shift: duplicating the sign bit is not a GF(2)-linear
# transform, and a state with the top bits set could stop being a
# bijection. Masking the result with `shr7_mask` (57 ones) clears exactly
# the bits sign extension would have filled, so `(x >> 7) & shr7_mask` IS
# the logical shift.
#
# `<<` wraps into i64 on both engines (mir_interp normalises, native code
# wraps by construction), which is what xorshift needs and what the
# differential tests in test_bitwise.py pin.
#
# `next()` answers bits 33..62 of the state — the high half, where a
# xorshift's bits are best mixed — as a value in [0, random_max).
# Adequate for tests, sampling and shuffling; NOT cryptographic.

export {
    Random,
    with_seed,
    with_sequence,
    next_below,
    next_range,
    next_bool,
    next_sign,
    choose,
    take_random,
    shuffle,
    random_max
};

# Answer a non-negative int below `random_max`. Declared with no default:
# unhandled, this is a loud error (see the header).
effect Random {
    fn next() -> int
}

# `next()` answers a value in [0, random_max).
let random_max = 1073741824;

# random_max - 1: the 30 low bits `next()` keeps.
let random_mask = 1073741823;

# (1 << 57) - 1. ANDing after `x >> 7` clears the seven bits arithmetic
# shift filled with copies of the sign, turning it into a logical shift.
let shr7_mask = 144115188075855871;

# Marsaglia's canonical non-zero xorshift64 seed. 0 is the generator's one
# fixed point, so the seed is folded away from it (normalize_seed).
let xorshift_base = 88172645463325252;

# ---------------------------------------------------------------------
# Handlers (the sources)
# ---------------------------------------------------------------------

# Run `f` with a deterministic xorshift64 seeded by `seed`; answers f's
# result. The same seed always produces the same sequence, on every
# backend — that is what makes randomized tests reproducible.
#
# Any int is a usable seed: it is xored away from the generator's fixed
# point and then stirred, so neighbouring seeds (0, 1, 2 ...) do not
# produce neighbouring first draws.
fn with_seed(seed: int, f) {
    let @mut state = stir(normalize_seed(seed));
    handle Random with {
        next() -> {
            state = xorshift(state);
            resume((state >> 33) & random_mask)
        }
    } in {
        f()
    }
}

# Run `f` answering the elements of `values` in order, cycling when they
# run out. A scripted generator: the way to pin the exact draws a test
# depends on without depending on the LCG's internals at all.
# An empty `values` answers 0 forever.
fn with_sequence(values: Vec, f) {
    let @mut i = 0;
    handle Random with {
        next() -> {
            let n = len(values);
            if n == 0 {
                resume(0)
            } else {
                let v = values[i % n];
                i = i + 1;
                resume(v)
            }
        }
    } in {
        f()
    }
}

# ---------------------------------------------------------------------
# Draws (plain functions over the effect)
# ---------------------------------------------------------------------

# A draw in [0, n). `n <= 0` answers 0 rather than dividing by zero.
fn next_below(n: int) -> int {
    if n <= 0 { 0 } else { perform Random.next() % n }
}

# A draw in [lo, hi). An empty or inverted range answers `lo`.
fn next_range(lo: int, hi: int) -> int {
    lo + next_below(hi - lo)
}

# A fair coin.
fn next_bool() -> bool {
    next_below(2) == 1
}

# -1 or 1, with equal probability.
fn next_sign() -> int {
    if next_bool() { 1 } else { 0 - 1 }
}

# Some(a uniformly chosen element of v), or None when v is empty.
fn choose(v: Vec) {
    if len(v) == 0 {
        None
    } else {
        Some(v[next_below(len(v))])
    }
}

# A fresh Vec of `n` draws below `bound` (empty when n <= 0).
fn take_random(n: int, bound: int) -> Vec {
    let @mut out = Vec.new();
    let @mut i = 0;
    while i < n {
        out.push(next_below(bound));
        i = i + 1
    }
    out
}

# A fresh Vec holding v's elements in a uniformly random order
# (Fisher-Yates, drawing from the unshuffled prefix). `v` is untouched.
fn shuffle(v: Vec) -> Vec {
    let @mut out = Vec.new();
    let @mut i = 0;
    while i < len(v) {
        out.push(v[i]);
        i = i + 1
    }
    let @mut k = len(out) - 1;
    while k > 0 {
        let j = next_below(k + 1);
        let tmp = out[k];
        out[k] = out[j];
        out[j] = tmp;
        k = k - 1
    }
    out
}

# private: one xorshift64 step. `(x >> 7) & shr7_mask` is the LOGICAL
# right shift the algorithm calls for (see the header).
fn xorshift(state: int) -> int {
    let a = state ^ (state << 13);
    let b = a ^ ((a >> 7) & shr7_mask);
    b ^ (b << 17)
}

# private: fold any int to a non-zero state (0 is xorshift's fixed point).
fn normalize_seed(seed: int) -> int {
    let s = seed ^ xorshift_base;
    if s == 0 { xorshift_base } else { s }
}

# private: three discarded steps, so a low-entropy seed (0, 1, 2 ...) has
# a well-mixed state before the first draw is taken.
fn stir(state: int) -> int {
    xorshift(xorshift(xorshift(state)))
}
