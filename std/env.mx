# std.env — the process environment as an effect.
#
# Arguments, variables, the home directory and the working directory
# (docs/io_runtime.md). Each operation maps to a runtime primitive on
# both engines; a handler in scope overrides it, which is how a test
# gives a program a fake command line or a fake HOME.

export {
    Env,
    args,
    lookup,
    get_or,
    has,
    home,
    cwd
}

effect Env = {
    fn args() -> Vec with EFFECT_ENV_ARGS
    fn get_raw(name: string) -> string with EFFECT_ENV_GET
    fn has(name: string) -> bool with EFFECT_ENV_HAS
    fn home() -> string with EFFECT_ENV_HOME
    fn cwd() -> string with EFFECT_ENV_CWD
}

# The command-line arguments after the program name, as strings.
fn args() -> Vec {
    perform Env.args()
}

# Some(value) when the variable is set (an empty value counts as set),
# else None.
fn lookup(name: string) -> Option {
    if perform Env.has(name) { Some(perform Env.get_raw(name)) } else { None }
}

# The variable's value, or `default` when it is unset.
fn get_or(name: string, default: string) -> string {
    if perform Env.has(name) { perform Env.get_raw(name) } else { default }
}

fn has(name: string) -> bool {
    perform Env.has(name)
}

# The home directory: $HOME, else the password database's entry.
fn home() -> string {
    perform Env.home()
}

# The current working directory.
fn cwd() -> string {
    perform Env.cwd()
}
