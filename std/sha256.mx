# std.sha256 — SHA-256 in Metaxu.
#
# FIPS 180-4, over bytes held as a Vec of ints in 0..255 (the same
# representation `s.to_bytes()` produces). Written in the language rather
# than bound to C so a native binary needs no libcrypto and so the
# interpreter, the semantics reference, computes the same digest; the
# test runs both against Python's hashlib. All arithmetic is 32-bit
# unsigned: values are kept in 0..2^32-1 and masked after every add and
# shift, which Metaxu's defined-wrapping 64-bit ops make exact.
#
# glade hashes a vendored tree as sha256 over sorted relative paths and
# file contents (`packages.tree_hash`); `sha256_hex` is that digest's
# text form.

from std.hex import to_hex;

export {
    sha256,
    sha256_hex,
    sha256_string
}

# The 32-byte digest of `data` (a Vec of byte values), as a Vec of ints.
fn sha256(data: Vec) -> Vec {
    let mask = 4294967295;
    let k = round_constants();
    let @mut h = initial_state();
    let msg = padded(data);
    let @mut w = zeros(64);
    let @mut block = 0;
    while block < len(msg) {
        let @mut i = 0;
        while i < 16 {
            let p = block + i * 4;
            w[i] = (msg[p] << 24) | (msg[p + 1] << 16) | (msg[p + 2] << 8) | msg[p + 3];
            i = i + 1
        }
        while i < 64 {
            let w15 = w[i - 15];
            let w2 = w[i - 2];
            let s0 = rotr(w15, 7) ^ rotr(w15, 18) ^ (w15 >> 3);
            let s1 = rotr(w2, 17) ^ rotr(w2, 19) ^ (w2 >> 10);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & mask;
            i = i + 1
        }
        let @mut a = h[0];
        let @mut b = h[1];
        let @mut c = h[2];
        let @mut d = h[3];
        let @mut e = h[4];
        let @mut f = h[5];
        let @mut g = h[6];
        let @mut hh = h[7];
        let @mut r = 0;
        while r < 64 {
            let big1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
            let ch = (e & f) ^ ((~e & mask) & g);
            let t1 = (hh + big1 + ch + k[r] + w[r]) & mask;
            let big0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
            let maj = (a & b) ^ (a & c) ^ (b & c);
            let t2 = (big0 + maj) & mask;
            hh = g;
            g = f;
            f = e;
            e = (d + t1) & mask;
            d = c;
            c = b;
            b = a;
            a = (t1 + t2) & mask;
            r = r + 1
        }
        h[0] = (h[0] + a) & mask;
        h[1] = (h[1] + b) & mask;
        h[2] = (h[2] + c) & mask;
        h[3] = (h[3] + d) & mask;
        h[4] = (h[4] + e) & mask;
        h[5] = (h[5] + f) & mask;
        h[6] = (h[6] + g) & mask;
        h[7] = (h[7] + hh) & mask;
        block = block + 64
    }
    let @mut out = Vec.new();
    let @mut j = 0;
    while j < 8 {
        let v = h[j];
        out.push((v >> 24) & 255);
        out.push((v >> 16) & 255);
        out.push((v >> 8) & 255);
        out.push(v & 255);
        j = j + 1
    }
    out
}

# The digest as 64 lowercase hex digits.
fn sha256_hex(data: Vec) -> string {
    to_hex(sha256(data))
}

# The hex digest of a string's UTF-8 bytes.
fn sha256_string(text: string) -> string {
    sha256_hex(text.to_bytes())
}

# Rotate a 32-bit value right by n (0 < n < 32).
fn rotr(x: int, n: int) -> int {
    ((x >> n) | (x << (32 - n))) & 4294967295
}

fn zeros(n: int) -> Vec {
    let @mut v = Vec.new();
    let @mut i = 0;
    while i < n {
        v.push(0);
        i = i + 1
    }
    v
}

# `data` followed by the 0x80 marker, zero padding to 56 mod 64, and the
# bit length as eight big-endian bytes.
fn padded(data: Vec) -> Vec {
    let @mut msg = Vec.new();
    let @mut i = 0;
    while i < len(data) {
        msg.push(data[i]);
        i = i + 1
    }
    msg.push(128);
    while len(msg) % 64 != 56 {
        msg.push(0)
    }
    let bits = len(data) * 8;
    let @mut shift = 56;
    while shift >= 0 {
        msg.push((bits >> shift) & 255);
        shift = shift - 8
    }
    msg
}

fn initial_state() -> Vec {
    let @mut h = Vec.new();
    h.push(1779033703);
    h.push(3144134277);
    h.push(1013904242);
    h.push(2773480762);
    h.push(1359893119);
    h.push(2600822924);
    h.push(528734635);
    h.push(1541459225);
    h
}

# The 64 round constants (fractional parts of the cube roots of the first
# 64 primes), in decimal because Metaxu has no hex literals.
fn round_constants() -> Vec {
    let @mut k = Vec.new();
    k.push(1116352408); k.push(1899447441); k.push(3049323471); k.push(3921009573);
    k.push(961987163); k.push(1508970993); k.push(2453635748); k.push(2870763221);
    k.push(3624381080); k.push(310598401); k.push(607225278); k.push(1426881987);
    k.push(1925078388); k.push(2162078206); k.push(2614888103); k.push(3248222580);
    k.push(3835390401); k.push(4022224774); k.push(264347078); k.push(604807628);
    k.push(770255983); k.push(1249150122); k.push(1555081692); k.push(1996064986);
    k.push(2554220882); k.push(2821834349); k.push(2952996808); k.push(3210313671);
    k.push(3336571891); k.push(3584528711); k.push(113926993); k.push(338241895);
    k.push(666307205); k.push(773529912); k.push(1294757372); k.push(1396182291);
    k.push(1695183700); k.push(1986661051); k.push(2177026350); k.push(2456956037);
    k.push(2730485921); k.push(2820302411); k.push(3259730800); k.push(3345764771);
    k.push(3516065817); k.push(3600352804); k.push(4094571909); k.push(275423344);
    k.push(430227734); k.push(506948616); k.push(659060556); k.push(883997877);
    k.push(958139571); k.push(1322822218); k.push(1537002063); k.push(1747873779);
    k.push(1955562222); k.push(2024104815); k.push(2227730452); k.push(2361852424);
    k.push(2428436474); k.push(2756734187); k.push(3204031479); k.push(3329325298);
    k
}
