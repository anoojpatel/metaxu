fn main() -> int {
    let n = 5000000;
    let mut v = Vec.new();
    let mut i = 0;
    while i < n { v.push(i); i = i + 1 };
    let mut acc = 0;
    let mut r = 0;
    while r < 4 {
        let mut j = 0;
        while j < n { acc = acc + v[j]; j = j + 1 };
        r = r + 1
    };
    print(acc);
    0
}
